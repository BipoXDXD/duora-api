          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "maxPageSize fora de 1 a 100, ou pageToken que a API não gerou",
            "headers" : {
              "X-Request-Id" : {
                "$ref" : "#/components/headers/RequestId"
