  "paths" : {
    "/api/accounts/{accountId}:block" : {
      "post" : {
        "description" : "Idempotente: bloquear quem já está bloqueado também responde 204 e mantém a data do primeiro bloqueio. A resposta é a mesma se a outra pessoa tiver bloqueado você.",
        "operationId" : "blockAccount",
        "parameters" : [ {
          "description" : "Id da outra conta, como o app o recebe ao mostrar a pessoa",
          "in" : "path",
          "name" : "accountId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid",
            "maxLength" : 36,
            "minLength" : 36
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "A conta está bloqueada",
            "headers" : {
              "X-Request-Id" : {
                "$ref" : "#/components/headers/RequestId"
              }
            }
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Bloqueio de si mesmo, ou id que não é UUID",
            "headers" : {
              "X-Request-Id" : {
                "$ref" : "#/components/headers/RequestId"
              }
            }
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Sem credencial válida",
            "headers" : {
              "X-Request-Id" : {
                "$ref" : "#/components/headers/RequestId"
              }
            }
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Sessão web sem o token CSRF no header X-XSRF-TOKEN",
            "headers" : {
              "X-Request-Id" : {
                "$ref" : "#/components/headers/RequestId"
              }
            }
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Não há conta com esse id",
            "headers" : {
              "X-Request-Id" : {
                "$ref" : "#/components/headers/RequestId"
              }
            }
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Erro inesperado",
            "headers" : {
              "X-Request-Id" : {
                "$ref" : "#/components/headers/RequestId"
              }
            }
          }
        },
        "summary" : "Bloqueia outra conta",
        "tags" : [ "blocks" ]
      }
    },
