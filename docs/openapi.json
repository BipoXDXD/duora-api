  "components" : {
    "headers" : {
      "RequestId" : {
        "description" : "Correlation ID da requisição (trace id W3C); informe-o ao reportar um erro",
        "required" : true,
        "schema" : {
          "type" : "string",
          "maxLength" : 32,
          "minLength" : 32,
          "pattern" : "^[0-9a-f]{32}$"
        }
      }
    },
    "schemas" : {
      "BlockedAccount" : {
        "type" : "object",
        "properties" : {
          "accountId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Id da conta bloqueada",
            "maxLength" : 36,
            "minLength" : 36
          },
          "blockedAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Quando o bloqueio foi feito",
            "maxLength" : 35
          }
        },
        "required" : [ "accountId", "blockedAt" ]
      },
      "BlockedAccountsResponse" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "description" : "Bloqueios do mais recente para o mais antigo",
            "items" : {
              "$ref" : "#/components/schemas/BlockedAccount"
            },
            "maxItems" : 100
          },
          "nextPageToken" : {
            "type" : [ "string", "null" ],
            "description" : "Token da próxima página, ou null na última",
            "maxLength" : 200,
            "pattern" : "^[A-Za-z0-9_-]+$"
          }
        },
        "required" : [ "items", "nextPageToken" ]
      },
      "CurrentUserResponse" : {
        "type" : "object",
