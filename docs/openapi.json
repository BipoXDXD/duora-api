    "/api/me/blocked-accounts" : {
      "get" : {
        "description" : "Do bloqueio mais recente para o mais antigo, paginado por cursor. A última página vem com nextPageToken null.",
        "operationId" : "listBlockedAccounts",
        "parameters" : [ {
          "description" : "Quantos bloqueios no máximo nesta página",
          "in" : "query",
          "name" : "maxPageSize",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20,
            "maximum" : 100,
            "minimum" : 1
          }
        }, {
          "description" : "O nextPageToken da página anterior; ausente na primeira",
          "in" : "query",
          "name" : "pageToken",
          "required" : false,
          "schema" : {
            "type" : "string",
            "maxLength" : 200,
            "pattern" : "^[A-Za-z0-9_-]+$"
          }
        } ],
        "responses" : {
