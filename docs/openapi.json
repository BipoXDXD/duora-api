            "description" : "Nome de exibição no Entra, ou null se o usuário não tiver nome",
            "maxLength" : 256
          },
          "profileComplete" : {
            "type" : "boolean",
            "description" : "Se o perfil já tem o necessário para usar o Duora; se não, o front leva ao cadastro"
          }
        },
        "required" : [ "displayName", "profileComplete" ]
      },
      "EditProfileRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "description" : "Só os campos a mudar. Campo ausente não muda; null apaga.",
        "properties" : {
          "bio" : {
            "type" : [ "string", "null" ],
            "description" : "Apresentação curta, em parágrafos; vazio ou null apaga",
            "maxLength" : 300,
            "writeOnly" : true
          },
          "birthDate" : {
            "type" : [ "string", "null" ],
            "format" : "date",
            "description" : "Data de nascimento de maior de idade; informada uma vez, não muda nem é apagada",
            "maxLength" : 10,
            "writeOnly" : true
          },
          "displayName" : {
            "type" : [ "string", "null" ],
            "description" : "Nome que as outras pessoas veem, numa linha; não pode ser apagado",
            "maxLength" : 50,
            "minLength" : 1,
            "writeOnly" : true
          },
          "region" : {
            "type" : [ "string", "null" ],
            "description" : "Estado, pelo código ISO 3166-2; não pode ser apagado",
            "enum" : [ "BR-AC", "BR-AL", "BR-AP", "BR-AM", "BR-BA", "BR-CE", "BR-DF", "BR-ES", "BR-GO", "BR-MA", "BR-MT", "BR-MS", "BR-MG", "BR-PA", "BR-PB", "BR-PR", "BR-PE", "BR-PI", "BR-RJ", "BR-RN", "BR-RS", "BR-RO", "BR-RR", "BR-SC", "BR-SP", "BR-SE", "BR-TO", null ],
            "writeOnly" : true
          }
        }
      },
      "FileReportRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "description" : {
            "type" : [ "string", "null" ],
            "description" : "Relato livre em parágrafos, sem caracteres invisíveis; obrigatório com o motivo OTHER. Vazio ou só com espaços conta como ausente.",
            "maxLength" : 1000
          },
          "reason" : {
            "type" : "string",
            "description" : "Motivo, de uma lista fechada",
            "enum" : [ "HARASSMENT", "HATE_SPEECH", "SEXUAL_CONTENT", "VIOLENCE_OR_THREAT", "SCAM_OR_SPAM", "FAKE_PROFILE", "SUSPECTED_MINOR", "OTHER" ]
          },
          "reportedAccountId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Id da conta denunciada",
            "maxLength" : 36,
            "minLength" : 36
          }
        },
        "required" : [ "reason", "reportedAccountId" ]
      },
      "JoinWaitlistRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "description" : "Endereço de e-mail; espaços nas pontas são ignorados e a caixa é normalizada",
            "example" : "ana@example.com",
            "maxLength" : 254
          }
        },
        "required" : [ "email" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "description" : "Erro no formato RFC 9457. Sem stack trace, SQL nem nome de classe.",
        "properties" : {
          "detail" : {
            "type" : "string",
            "maxLength" : 1000
          },
          "instance" : {
            "type" : "string",
            "format" : "uri-reference",
            "maxLength" : 1000
          },
          "requestId" : {
            "type" : "string",
            "description" : "Correlation ID, o mesmo do header X-Request-Id; vem nos erros inesperados (500)",
            "maxLength" : 32,
            "minLength" : 32,
            "pattern" : "^[0-9a-f]{32}$"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 599,
            "minimum" : 100
          },
          "title" : {
            "type" : "string",
            "maxLength" : 1000
          },
          "type" : {
            "type" : "string",
            "format" : "uri-reference",
            "maxLength" : 1000
          }
        },
        "required" : [ "status", "title" ]
      },
      "ProfileResponse" : {
        "type" : "object",
        "properties" : {
          "bio" : {
            "type" : [ "string", "null" ],
            "description" : "Apresentação, ou null",
            "maxLength" : 300
          },
          "birthDate" : {
            "type" : [ "string", "null" ],
            "format" : "date",
            "description" : "Data de nascimento, ou null se ainda não informada",
            "maxLength" : 10
          },
          "complete" : {
            "type" : "boolean",
            "description" : "Nome, data de nascimento de maior de idade e região preenchidos"
          },
          "displayName" : {
            "type" : [ "string", "null" ],
            "description" : "Nome de exibição, ou null se ainda não informado",
            "maxLength" : 50
          },
          "region" : {
            "type" : [ "string", "null" ],
            "description" : "Estado, pelo código ISO 3166-2, ou null se ainda não informado",
            "enum" : [ "BR-AC", "BR-AL", "BR-AP", "BR-AM", "BR-BA", "BR-CE", "BR-DF", "BR-ES", "BR-GO", "BR-MA", "BR-MT", "BR-MS", "BR-MG", "BR-PA", "BR-PB", "BR-PR", "BR-PE", "BR-PI", "BR-RJ", "BR-RN", "BR-RS", "BR-RO", "BR-RR", "BR-SC", "BR-SP", "BR-SE", "BR-TO", null ]
          }
        },
        "required" : [ "bio", "birthDate", "complete", "displayName", "region" ]
      },
      "ReportResponse" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Quando a denúncia foi feita",
            "maxLength" : 35
          },
          "description" : {
            "type" : [ "string", "null" ],
            "description" : "O relato, ou null se não houve",
            "maxLength" : 1000
          },
          "id" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Id da denúncia",
            "maxLength" : 36,
            "minLength" : 36
          },
          "reason" : {
            "type" : "string",
            "enum" : [ "HARASSMENT", "HATE_SPEECH", "SEXUAL_CONTENT", "VIOLENCE_OR_THREAT", "SCAM_OR_SPAM", "FAKE_PROFILE", "SUSPECTED_MINOR", "OTHER" ]
          },
          "reportedAccountId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Id da conta denunciada",
            "maxLength" : 36,
            "minLength" : 36
          },
          "status" : {
            "type" : "string",
            "description" : "Estado na moderação",
            "enum" : [ "OPEN" ]
          }
        },
        "required" : [ "createdAt", "description", "id", "reason", "reportedAccountId", "status" ]
      },
      "WaitlistStatsResponse" : {
        "type" : "object",
        "properties" : {
          "total" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Inscrições na lista",
            "maximum" : 9223372036854775807,
            "minimum" : 0
          }
        },
        "required" : [ "total" ]
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "description" : "Access token da duora-api emitido pelo Entra External ID, validado conforme a RFC8725: algoritmo fixo (RS256) e iss, aud, exp e oid obrigatórios.",
        "scheme" : "bearer",
        "type" : "http"
      },
      "session" : {
        "description" : "Sessão do front web, criada pelo login em /oauth2/authorization/entra",
        "in" : "cookie",
        "name" : "__Host-DUORA_SESSION",
        "type" : "apiKey"
      }
    }
  }
